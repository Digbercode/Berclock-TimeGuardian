
<Window x:Class="Win7AlarmClassic.UI.AlarmRingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BerClock"
        Width="1000"
        Height="620"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True"
        Background="#080605"
        KeyDown="Window_KeyDown">

    <Grid>

        <!-- FUNDO -->
        <Grid Background="#080605">

            <Border Margin="12"
                    BorderBrush="#5B3A14"
                    BorderThickness="6">

                <Border Margin="10"
                        BorderBrush="#BF8C30"
                        BorderThickness="2">

                    <Border Margin="6"
                            BorderBrush="#5E411E"
                            BorderThickness="1">

                        <Grid>

                            <!-- FUNDO GRADIENTE -->
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="0,1">
                                    <GradientStop Color="#080605"
                                                  Offset="0"/>
                                    <GradientStop Color="#301E15"
                                                  Offset="1"/>
                                </LinearGradientBrush>
                            </Grid.Background>

                            <!-- CABEÇALHO -->
                            <Grid Height="100"
                                  VerticalAlignment="Top"
                                  Margin="35,0,35,0">

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock Text="◈  B E R C L O C K"
                                               FontFamily="Georgia"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#F4CB63"/>

                                </StackPanel>

                                <TextBlock Text="●  ALARM ACTIVE"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe UI"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#9B221E"/>

                            </Grid>

                            <!-- LINHA DO CABEÇALHO -->
                            <Border Height="1"
                                    Margin="35,100,35,0"
                                    VerticalAlignment="Top"
                                    Background="#5E411E"/>

                            <!-- ÁREA PRINCIPAL -->
                            <Grid Margin="35,125,35,40">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="340"/>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <!-- ================================= -->
                                <!-- CÂMARA DA ENTIDADE -->
                                <!-- ================================= -->

                                <Border Grid.Column="0"
                                        BorderThickness="5"
                                        BorderBrush="#5B3A14"
                                        Background="#1F1511">

                                    <Border Margin="7"
                                            BorderThickness="2"
                                            BorderBrush="#BF8C30">

                                        <Grid>

                                            <TextBlock Text="◈  SUMMONED ENTITY  ◈"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"
                                                       Margin="0,15,0,0"
                                                       FontFamily="Georgia"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#BF8C30"/>

                                            <!-- ÁREA DO GIF -->
                                            <Border Margin="25,55,25,55"
                                                    Background="#070504"
                                                    BorderBrush="#3A2617"
                                                    BorderThickness="2">

                                                <Image x:Name="WizardImage"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                            </Border>

                                            <TextBlock Text="◈  BERCLOCK ENTITY  ◈"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0,0,0,18"
                                                       FontFamily="Segoe UI"
                                                       FontSize="8"
                                                       FontWeight="Bold"
                                                       Foreground="#825C2A"/>

                                        </Grid>

                                    </Border>

                                </Border>


                                <!-- ================================= -->
                                <!-- PAINEL DO ALARME -->
                                <!-- ================================= -->

                                <Border Grid.Column="2"
                                        BorderThickness="5"
                                        BorderBrush="#5B3A14"
                                        Background="#1F1511">

                                    <Border Margin="7"
                                            BorderThickness="2"
                                            BorderBrush="#BF8C30">

                                        <Grid>

                                            <TextBlock Text="◈  ALARM SEAL  ◈"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"
                                                       Margin="0,17,0,0"
                                                       FontFamily="Georgia"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="#F4CB63"/>


                                            <!-- NOME DO ALARME -->

                                            <TextBlock x:Name="AlarmNameText"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"
                                                       Margin="25,62,25,0"
                                                       Height="38"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontFamily="Segoe UI"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#E8DAB6"/>


                                            <!-- DISPLAY -->

                                            <Border Width="425"
                                                    Height="115"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Margin="0,112,0,0"
                                                    Background="#080504"
                                                    BorderBrush="#5B3A14"
                                                    BorderThickness="4">

                                                <Border Margin="7"
                                                        BorderBrush="#BF8C30"
                                                        BorderThickness="1">

                                                    <TextBlock x:Name="ClockText"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Consolas"
                                                               FontSize="40"
                                                               FontWeight="Bold"
                                                               Foreground="#F4CB63"
                                                               Text="00:00:00"/>

                                                </Border>

                                            </Border>


                                            <!-- TEMPO RESTANTE -->

                                            <TextBlock x:Name="RemainingText"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"
                                                       Margin="30,240,30,0"
                                                       Height="32"
                                                       TextAlignment="Center"
                                                       FontFamily="Segoe UI"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#AB8448"/>


                                            <!-- BARRA -->

                                            <Border Width="425"
                                                    Height="6"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Margin="0,280,0,0"
                                                    Background="#140C08">

                                                <Grid>

                                                    <Border x:Name="ProgressBar"
                                                            HorizontalAlignment="Left"
                                                            Width="380"
                                                            Height="3"
                                                            Margin="0,1,0,0"
                                                            Background="#BF8C30"/>

                                                </Grid>

                                            </Border>


                                            <!-- BOTÃO -->

                                            <Button Width="245"
                                                    Height="62"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Margin="0,305,0,0"
                                                    Click="DismissButton_Click"
                                                    Cursor="Hand"
                                                    Background="#3F2717"
                                                    Foreground="#E8DAB6"
                                                    BorderBrush="#BF8C30"
                                                    BorderThickness="3"
                                                    FontFamily="Georgia"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Content="◈  DISPENSAR  ◈">

                                                <Button.Template>

                                                    <ControlTemplate TargetType="Button">

                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}">

                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>

                                                        </Border>

                                                    </ControlTemplate>

                                                </Button.Template>

                                            </Button>

                                        </Grid>

                                    </Border>

                                </Border>

                            </Grid>

                        </Grid>

                    </Border>

                </Border>

            </Border>

        </Grid>

    </Grid>

</Window>
